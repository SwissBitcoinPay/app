node_modules/
dist/
build/
*.log

# Secrets: never committed, at any depth.
.env*
!.env.example
*.key
*.pem
*.p12
*.p8
*.jks
*.keystore
*.mobileprovision
credentials.json
google-service-account*.json
# Firebase's service account key ("Generate new private key"): it goes to EAS only.
*firebase-adminsdk*.json
# Root only: a `keys` source folder (e.g. key derivation code) must stay tracked.
/keys/

# Expo
.expo/
web-build/
expo-env.d.ts

# Passkey association files, written at deploy time from the EAS environment
# (scripts/passkey-association.js): their data never goes in git. security.txt and its OpenPGP
# key are the exception, the same for every variant (SECURITY.md).
/public/.well-known/*
!/public/.well-known/security.txt
!/public/.well-known/pgp-key.txt

# The web app's manifest, its variant's icon and tab icon, written at export time from the app
# config (scripts/web-manifest.js): they depend on the variant.
/public/manifest.webmanifest
/public/apple-touch-icon.png
/public/favicon.ico

# Native projects are generated by `expo prebuild` (Continuous Native Generation).
# Configure native behaviour in app.config.ts / config plugins, never by hand.
/android
/ios

# Native build leftovers
.kotlin/
*.orig.*

# Metro
.metro-health-check*

# Tests and lint caches
coverage/
.eslintcache

# TypeScript
*.tsbuildinfo

# OS / editors
.DS_Store
.idea/

# Claude Code: personal, machine-local settings (the shared ones are committed)
.claude/settings.local.json

# The Wix plugin's files that the app's Wix guide copies, fetched from its latest release when the
# app is bundled (scripts/wix-plugin.js, run by metro.config.js). Jest reads jest/wix-plugin/.
/assets/plugins/wix/
