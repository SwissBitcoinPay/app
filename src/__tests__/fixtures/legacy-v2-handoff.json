          "mail": "carol@example.ch"
        },
        "token": "eyJhbGciOiJFZERTQSJ9.eyJzdWIiOiJ4In0.c2lnbmF0dXJlX29mX3RoZV90b2tlbg"
      },
      "fragment": "#",
