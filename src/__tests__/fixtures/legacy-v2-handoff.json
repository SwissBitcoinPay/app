    "app": "https://app.swiss-bitcoin-pay.ch",
    "dashboard": "https://dashboard.swiss-bitcoin-pay.ch"
  },
  "requests": {
    "app": "#sbp-from=app",
    "dashboard": "#sbp-from=dashboard"
  },
  "fetchPath": "/sattleme",
  "nonce": "AAECAwQFBgcICQoLDA0ODw",
  "vectors": [
