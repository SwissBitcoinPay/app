{
  "name": "sattle-me",
  "version": "3.0.0",
  "private": true,
  "main": "index.ts",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.23.5",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "^10.9.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "node scripts/web-manifest.js && expo start --web",
    "lint": "expo lint",
    "typecheck": "expo customize tsconfig.json && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm test",
    "doctor": "npx expo-doctor@1.21.5",
    "export:web": "node scripts/web-manifest.js && expo export --platform web",
    "build:android:local": "scripts/build-android-local.sh",
    "release-notes": "node scripts/release-notes.js",
    "store-screenshots": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/store-screenshots/capture.mjs"
  },
  "dependencies": {
    "@breeztech/breez-sdk-spark": "0.28.4",
    "@breeztech/breez-sdk-spark-react-native": "0.28.4",
    "@noble/ciphers": "2.4.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@scure/bip32": "2.4.0",
    "@scure/btc-signer": "2.4.1",
    "barcode-detector": "3.2.3",
    "country-flag-icons": "1.6.20",
    "expo": "58.1.0",
    "expo-asset": "58.0.21",
    "expo-audio": "58.0.12",
    "expo-build-properties": "58.0.12",
    "expo-camera": "58.0.14",
    "expo-clipboard": "58.0.4",
    "expo-constants": "58.0.16",
    "expo-crypto": "58.0.9",
    "expo-file-system": "58.0.15",
    "expo-image-manipulator": "58.0.16",
    "expo-image-picker": "58.0.10",
    "expo-linking": "58.0.17",
    "expo-local-authentication": "58.0.3",
    "expo-localization": "58.0.5",
    "expo-mail-composer": "58.0.4",
    "expo-notifications": "58.1.10",
    "expo-observe": "58.1.0",
    "expo-print": "58.0.9",
    "expo-router": "58.0.33",
    "expo-screen-capture": "58.0.6",
    "expo-secure-store": "58.0.3",
    "expo-sharing": "58.0.24",
    "expo-splash-screen": "58.0.15",
    "expo-status-bar": "58.0.5",
    "expo-system-ui": "58.0.7",
    "expo-task-manager": "58.0.14",
    "expo-updates": "58.0.23",
    "fflate": "0.8.3",
    "i18n-iso-countries": "7.14.0",
    "i18next": "27.1.1",
    "jail-monkey": "3.0.0",
    "qrcode-generator": "2.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "18.0.1",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-keychain": "10.0.0",
    "react-native-nfc-manager": "4.2.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "whatwg-url-minimum": "0.2.0",
    "zxing-wasm": "3.1.6"
  },
  "devDependencies": {
    "@babel/plugin-transform-modules-commonjs": "7.29.14",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-expo": "58.0.4",
    "eslint-config-prettier": "10.1.8",
    "jest": "30.5.2",
    "jest-expo": "58.0.16",
    "prettier": "3.10.1",
    "test-renderer": "1.3.1",
    "typescript": "6.0.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "enabled": false
      }
    },
    "autolinking": {
      "ios": {
        "exclude": [
          "expo-task-manager",
          "unimodules-app-loader",
          "jail-monkey"
        ]
      }
    }
  },
  "overrides": {
    "node-forge": "1.4.3"
  }
}
