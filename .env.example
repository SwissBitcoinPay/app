# Copy to .env.local (gitignored) for local builds and `npm start`. Never commit a real key.
# EXPO_PUBLIC_* variables are inlined into the JS bundle: readable by anyone who has the app.
# EAS builds and updates read it from the EAS environments instead.

# Breez API key, required on mainnet (both app variants): https://breez.technology/request-api-key/#contact-us-form-sdk
EXPO_PUBLIC_BREEZ_API_KEY=

# Passkey RP ID (a bare domain, no https://): the domain the passkeys, and so the wallets, are bound
# to; the domain must declare the app in its association files. In the app config, so public too. Without it, the app starts but refuses passkeys.
PASSKEY_RP_ID=

# Contact address sent to Open Food Facts with each barcode scan of "Items" (its API asks for
# a User-Agent "AppName/Version (ContactEmail)"). Public: inlined into the bundle and sent with
# every scan. Without it, the User-Agent names the source repository instead.
EXPO_PUBLIC_OPEN_FOOD_FACTS_EMAIL=

